<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gordian.App.ViewModels"
        xmlns:net="clr-namespace:Gordian.Core.Network;assembly=Gordian.Core"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="480"
        x:Class="Gordian.App.ChatWindow"
        x:DataType="vm:ChatViewModel"
        Title="GordianXI - In-Game Chat Console" Width="720" Height="500" MinWidth="480" MinHeight="320"
        Background="#1E1E1E" RequestedThemeVariant="Dark">

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">

        <!-- TOP BAR: Session Selector, Filter, Clear -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto, 150, *, Auto, Auto">
                <TextBlock Grid.Column="0" Text="Session:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ActiveSessions}"
                          SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="net:CharacterSession">
                            <TextBlock Text="{Binding CharacterName}" FontSize="12"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Filter ComboBox -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding ChannelFilter, Mode=TwoWay}"
                              Width="105"/>
                </StackPanel>

                <!-- Clear Button -->
                <Button Grid.Column="4"
                        Content="Clear"
                        Command="{Binding ClearLogCommand}"
                        Background="#3E3E42" Foreground="#DCDCDC"
                        FontSize="11" Margin="8,0,0,0" Padding="8,4" CornerRadius="4"/>
            </Grid>
        </Border>

        <!-- CHAT LOG DISPLAY -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="6">
            <ListBox x:Name="ChatListBox"
                     ItemsSource="{Binding FilteredMessages}"
                     Background="#1E1E1E" CornerRadius="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatItemViewModel">
                        <Grid ColumnDefinitions="Auto, Auto, Auto, *" Margin="0,1">
                            <!-- Timestamp -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimeDisplay}"
                                       Foreground="#808080" FontSize="11"
                                       FontFamily="Consolas, Courier New, monospace"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>

                            <!-- Channel Badge -->
                            <Border Grid.Column="1" Background="#2D2D30" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}"
                                           Foreground="{Binding BadgeColor}"
                                           FontSize="11" FontWeight="Bold"/>
                            </Border>

                            <!-- Sender -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Sender, StringFormat='{}{0}: '}"
                                       Foreground="{Binding SenderColor}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>

                            <!-- Message Body -->
                            <SelectableTextBlock Grid.Column="3"
                                                 Text="{Binding Message}"
                                                 Foreground="{Binding MessageColor}"
                                                 FontSize="12" TextWrapping="Wrap"
                                                 VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- BOTTOM COMPOSER BAR -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
            <Grid RowDefinitions="Auto, Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto">
                    <!-- Channel Picker -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding ChannelOptions}"
                              SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                              Width="110" Margin="0,0,8,0"/>

                    <!-- Tell Recipient (Visible only for Tell) -->
                    <TextBox Grid.Column="1"
                             Text="{Binding TellRecipient, Mode=TwoWay}"
                             PlaceholderText="Recipient..."
                             Width="110" Margin="0,0,8,0"
                             IsVisible="{Binding IsTellChannel}"/>

                    <!-- Message Input Box -->
                    <TextBox Grid.Column="2"
                             x:Name="MessageInputBox"
                             Text="{Binding OutgoingMessage, Mode=TwoWay}"
                             PlaceholderText="Type a message... (Press Enter or click Send)"
                             KeyDown="OnMessageInputKeyDown"
                             Margin="0,0,8,0"/>

                    <!-- Send Button -->
                    <Button Grid.Column="3"
                            Content="Send"
                            Command="{Binding SendMessageCommand}"
                            Background="#512BD4" Foreground="White"
                            FontWeight="Bold" Padding="14,6" CornerRadius="4"/>
                </Grid>

                <!-- Status Strip -->
                <TextBlock Grid.Row="1"
                           Text="{Binding StatusText}"
                           Foreground="#888888" FontSize="11"
                           Margin="2,4,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
