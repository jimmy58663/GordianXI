<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Gordian.App.ViewModels"
        xmlns:net="clr-namespace:Gordian.Core.Network;assembly=Gordian.Core"
        xmlns:common="clr-namespace:Gordian.App.Common"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="840"
        x:Class="Gordian.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GordianXI - Client and Network Inspector" Width="1280" Height="840" MinWidth="1100" MinHeight="720"
        Background="#1E1E1E" RequestedThemeVariant="Dark">

    <Window.Styles>
        <Style Selector="Thumb.colHeaderThumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Rectangle Width="1" Fill="#333333" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Status & Debug Toolbar -->
        <Grid Grid.Row="0" Margin="12,6,12,2" ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="GORDIAN XI" FontWeight="Bold" FontSize="13" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                <TextBlock Text="|" Foreground="#555555" VerticalAlignment="Center"/>
                <TextBlock Text="64-Bit FFXI Client Engine" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding ShowStateInspector, Mode=TwoWay}"
                          Content="Debug: State Inspector"
                          FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Margin="8,0,8,8" Background="#1E1E1E">

        <!-- TAB 1: Profiles & Multi-Box Launch -->
        <TabItem Header="Profiles and Launch" FontSize="14" FontWeight="SemiBold">
            <Grid ColumnDefinitions="360, *" Margin="0,10,0,0">

                <!-- LEFT PANE: Active Profile Modifier Forms -->
                <Border Grid.Column="0" Background="#252526" Margin="0,0,8,0" CornerRadius="6" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>

                            <TextBlock Text="Profile Name:" Foreground="#A0A0A0" Margin="0,5,0,0"/>
                            <TextBox Text="{Binding FormProfileName, Mode=TwoWay}" PlaceholderText="e.g. Main Character / Crafting Mule"/>

                            <TextBlock Text="Character Name:" Foreground="#A0A0A0"/>
                            <TextBox Text="{Binding FormCharacterName, Mode=TwoWay}" PlaceholderText="e.g. Cybin (in-game name)"/>

                            <TextBlock Text="Username / Account:" Foreground="#A0A0A0"/>
                            <TextBox Text="{Binding FormUsername, Mode=TwoWay}" PlaceholderText="e.g. account_user"/>

                            <TextBlock Text="Password:" Foreground="#A0A0A0"/>
                            <TextBox Text="{Binding FormPassword, Mode=TwoWay}" PasswordChar="*" PlaceholderText="Account password"/>

                            <TextBlock Text="2FA Seed (Optional):" Foreground="#A0A0A0"/>
                            <TextBox Text="{Binding FormOtpSeed, Mode=TwoWay}" PlaceholderText="Base32 TOTP secret"/>

                            <TextBlock Text="Target Bootloader Path:" Foreground="#A0A0A0"/>
                            <TextBox Text="{Binding FormBootloaderPath, Mode=TwoWay}" PlaceholderText="xiloader.exe or pol.exe path..."/>

                            <TextBlock Text="Custom Arguments:" Foreground="#A0A0A0"/>
                            <TextBox Text="{Binding FormArguments, Mode=TwoWay}" PlaceholderText="--server server.domain.net --windowed"/>

                            <Separator Margin="0,5,0,5" Background="#3E3E42"/>

                            <Grid ColumnDefinitions="*, Auto">
                                <Button Grid.Column="0"
                                        Content="Save Profile Configuration"
                                        Command="{Binding SaveProfileCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Background="#512BD4" Foreground="White"/>

                                <Button Grid.Column="1"
                                        Content="Cancel"
                                        Command="{Binding ClearFormCommand}"
                                        IsVisible="{Binding IsEditing}"
                                        Margin="6,0,0,0"
                                        Background="#3E3E42" Foreground="White"/>
                            </Grid>

                            <Border Background="#1A1A1C" CornerRadius="4" Padding="10,8" Margin="0,8,0,0" MinHeight="52" BorderBrush="#333337" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E5C07B" FontSize="11" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- RIGHT PANE: Multi-Box Launch Queue Checklist -->
                <Grid Grid.Column="1" RowDefinitions="*, Auto" Margin="8,0,0,0">

                    <!-- Account Selection Checklist Table -->
                    <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Multi-Character Launch Checklist" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Select profiles to queue. Online characters will be automatically detected and skipped." FontSize="11" Foreground="#A0A0A0"/>

                            <Separator Margin="0,5,0,5" Background="#3E3E42"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProfileItemViewModel">
                                            <Border Margin="0,3" Padding="6,4" Background="#2D2D30" CornerRadius="4">
                                                <Grid ColumnDefinitions="Auto, 160, *, Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForLaunch, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CharacterSubtitle}" FontSize="11" Foreground="#888888" IsVisible="{Binding HasCharacterSubtitle}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentTwoFactorCode}" Foreground="#E5C07B" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Actions: Edit, Delete, Terminate -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="Edit"
                                                                Command="{Binding EditCommand}"
                                                                Background="#3E3E42" Foreground="#9CDCFE"
                                                                FontSize="11" FontWeight="SemiBold"
                                                                Padding="8,4" CornerRadius="3"/>

                                                        <Button Content="Delete"
                                                                Command="{Binding DeleteCommand}"
                                                                Background="#3E3E42" Foreground="#CE9178"
                                                                FontSize="11" FontWeight="SemiBold"
                                                                Padding="8,4" CornerRadius="3"/>

                                                        <!-- Individual Terminate Button (Visible when Online) -->
                                                        <Button Content="Terminate"
                                                                Command="{Binding TerminateCommand}"
                                                                IsVisible="{Binding IsOnline}"
                                                                Background="#D32F2F" Foreground="White"
                                                                FontSize="11" FontWeight="Bold"
                                                                Padding="8,4" CornerRadius="3"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Launch & Terminate Actions Execution Bar -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, 8, Auto" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Content="Launch Selected Characters (Smart Skip Active)"
                                Command="{Binding LaunchSelectedCommand}"
                                Height="45" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#8A2BE2" Foreground="White" FontSize="14" FontWeight="Bold"/>

                        <Button Grid.Column="2"
                                Content="Terminate All"
                                Command="{Binding TerminateAllCommand}"
                                Height="45" Padding="16,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#D32F2F" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>

        <!-- TAB 2: Live Network Packet Inspector -->
        <TabItem Header="Live Packet Inspector" FontSize="14" FontWeight="SemiBold">
            <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">

                <!-- TOP CONTROLS & FILTER TOOLBAR -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, 1.3*, 1*, Auto">
                        <!-- Direction Filter -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Direction:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding Inspector.DirectionOptions}"
                                      SelectedItem="{Binding Inspector.DirectionFilter, Mode=TwoWay}"
                                      Width="105"/>
                        </StackPanel>

                        <!-- Search Filter (Flexible Width) -->
                        <Grid Grid.Column="1" ColumnDefinitions="Auto, *" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Grid.Column="0" Text="Filter:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Inspector.SearchFilter, Mode=TwoWay}"
                                     PlaceholderText="Search Name / ID (0x015, POS)..."/>
                        </Grid>

                        <!-- Ignore Filter (Flexible Width) -->
                        <Grid Grid.Column="2" ColumnDefinitions="Auto, *" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Grid.Column="0" Text="Ignore:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Inspector.IgnoreFilter, Mode=TwoWay}"
                                     PlaceholderText="Ignore IDs (0x015, 0x00E)..."/>
                        </Grid>

                        <!-- Action Buttons & Status (Right-Docked) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Inspector.TotalPacketCount, StringFormat='Packets: {0}'}"
                                       Foreground="#9CDCFE" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>

                            <!-- On-demand Start / Stop Capture Button -->
                            <Button Content="{Binding Inspector.CaptureButtonText}"
                                    Command="{Binding Inspector.ToggleCaptureCommand}"
                                    Background="{Binding Inspector.CaptureButtonBackground}"
                                    Foreground="White" FontWeight="Bold"
                                    Padding="10,5" CornerRadius="4"/>

                            <!-- Pause / Resume Stream (Active during capture) -->
                            <Button Content="Pause"
                                    Command="{Binding Inspector.TogglePauseCommand}"
                                    IsVisible="{Binding Inspector.IsCapturing}"
                                    Background="#3E3E42" Foreground="White"
                                    Padding="8,5" CornerRadius="4"/>

                            <Button Content="Clear Log"
                                    Command="{Binding Inspector.ClearCommand}"
                                    Background="#C586C0" Foreground="White"
                                    Padding="8,5" CornerRadius="4"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SPLIT PACKET LIST & HEX DUMP INSPECTOR -->
                <Grid Grid.Row="1" ColumnDefinitions="480, 8, *">

                    <!-- LEFT: Packet Stream List -->
                    <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="8">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Table Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="45, 75, 55, 175, 45" Margin="4,4,4,8">
                                <TextBlock Grid.Column="0" Text="DIR" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="TIME" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="ID" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Grid.Column="3" Text="COMMAND" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Grid.Column="4" Text="SIZE" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Grid.Row="0" Margin="0,22,0,0" Background="#3E3E42"/>

                            <!-- Packet Items List -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Inspector.FilteredPackets}"
                                     SelectedItem="{Binding Inspector.SelectedPacket, Mode=TwoWay}"
                                     AutoScrollToSelectedItem="False"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="net:PacketLogEntry">
                                        <Grid ColumnDefinitions="45, 75, 55, 175, 45" Margin="0,2">
                                            <!-- Direction Tag -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Direction}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#4EC9B0"/>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.ff}'}"
                                                       FontSize="11" Foreground="#A0A0A0"
                                                       FontFamily="Consolas, Courier New, monospace"/>

                                            <!-- Packet ID -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PacketId, StringFormat='0x{0:X3}'}"
                                                       FontSize="11" Foreground="#CE9178"
                                                       FontFamily="Consolas, Courier New, monospace"/>

                                            <!-- Packet Name -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding PacketName}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#DCDCDC" TextTrimming="CharacterEllipsis"/>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Size, StringFormat='{}{0}B'}"
                                                       FontSize="11" Foreground="#9CDCFE"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="Consolas, Courier New, monospace"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Splitter Bar -->
                    <GridSplitter Grid.Column="1" Background="#1E1E1E" ResizeDirection="Columns"/>

                    <!-- RIGHT: Dual-Column Hex & ASCII Inspector -->
                    <Border Grid.Column="2" Background="#252526" CornerRadius="6" Padding="12">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0"
                                       Text="Packet Hex and ASCII Dump"
                                       FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" Padding="10">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <SelectableTextBlock Text="{Binding Inspector.FormattedDump}"
                                                         FontFamily="Consolas, Courier New, monospace"
                                                         FontSize="12"
                                                         Foreground="#D4D4D4"
                                                         LineHeight="18"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- TAB 3: Character & World State Inspector -->
        <TabItem Header="State &amp; World Inspector" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding ShowStateInspector}">
            <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">

                <!-- TOP TELEMETRY & ACTIVE SESSION STRIP -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, 150, *">
                        <!-- Active Session Selector -->
                        <TextBlock Grid.Column="0" Text="Session:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StateInspector.ActiveSessions}"
                                  SelectedItem="{Binding StateInspector.SelectedSession, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="net:CharacterSession">
                                    <TextBlock Text="{Binding CharacterName}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Real-Time Metrics Badges (StackPanel ensures badges remain strictly single-row) -->
                        <!-- Real-Time Metrics Badges (2 rows to prevent horizontal overflow) -->
                        <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                            <!-- ROW 1: Network & Memory -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                <!-- Inbound Telemetry -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="IN:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.PacketsInRateText}" Foreground="#4EC9B0" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                        <TextBlock Text="{Binding StateInspector.BandwidthInText, StringFormat='({0})'}" Foreground="#A0A0A0" FontSize="10" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>

                                <!-- Outbound Telemetry -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="OUT:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.PacketsOutRateText}" Foreground="#CE9178" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                        <TextBlock Text="{Binding StateInspector.BandwidthOutText, StringFormat='({0})'}" Foreground="#A0A0A0" FontSize="10" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>

                                <!-- Drops / Sequence gaps -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="DROPS:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.SequenceDropsText}" Foreground="#9CDCFE" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>

                                <!-- Heap Memory -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="HEAP:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.HeapMemoryText}" Foreground="#E5C07B" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>

                                <!-- GC Collections & Pressure -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="GC(0/1/2):" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.GcCollectionsText}" Foreground="#DCDCDC" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                        <TextBlock Text="{Binding StateInspector.GcPressureText, StringFormat='({0})'}" Foreground="#888888" FontSize="10" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ROW 2: Simulation & Timing -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                <!-- Spatial Partition Grid Queries -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="GRID:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.SpatialQueryText}" Foreground="#4EC9B0" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dead Reckoning Extrapolation -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="RECKONING:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.DeadReckoningText}" Foreground="#61AFEF" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dispatch Latency -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="5,2" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="LATENCY:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StateInspector.DispatchLatencyText}" Foreground="#C586C0" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SPLIT PLAYER VITALS & WORLD ENTITIES -->
                <Grid Grid.Row="1" ColumnDefinitions="360, 8, *">

                    <!-- LEFT COLUMN: Player Identity & Vitals Card -->
                    <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <!-- Character Header Banner -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding StateInspector.CharacterName}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding StateInspector.CharacterIdDisplay}" FontSize="11" Foreground="#888888" FontFamily="Consolas, Courier New, monospace"/>
                                            <TextBlock Text="{Binding StateInspector.ServerAddressDisplay, StringFormat='Server: {0}'}" FontSize="11" Foreground="#A0A0A0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="4" Padding="6,4" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StateInspector.SessionStateDisplay}" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Job Badge -->
                                <Border Background="#2D2D30" CornerRadius="4" Padding="8,6">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Column="0" Text="JOB:" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StateInspector.JobDisplay}" Foreground="#9CDCFE" FontSize="13" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- Vitals Gauges (HP, MP, TP) -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="10">
                                        <!-- HP Bar -->
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <TextBlock Grid.Column="0" Text="HP" FontWeight="Bold" FontSize="12" Foreground="#E06C75"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StateInspector.HpText}" HorizontalAlignment="Right" FontSize="11" Foreground="#DCDCDC" FontFamily="Consolas, Courier New, monospace"/>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding StateInspector.HpPercent}"
                                                         Height="12" CornerRadius="3"
                                                         Foreground="#E06C75" Background="#2D2D30"/>
                                        </StackPanel>

                                        <!-- MP Bar -->
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <TextBlock Grid.Column="0" Text="MP" FontWeight="Bold" FontSize="12" Foreground="#61AFEF"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StateInspector.MpText}" HorizontalAlignment="Right" FontSize="11" Foreground="#DCDCDC" FontFamily="Consolas, Courier New, monospace"/>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding StateInspector.MpPercent}"
                                                         Height="12" CornerRadius="3"
                                                         Foreground="#61AFEF" Background="#2D2D30"/>
                                        </StackPanel>

                                        <!-- TP Bar -->
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <TextBlock Grid.Column="0" Text="TP" FontWeight="Bold" FontSize="12" Foreground="#E5C07B"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StateInspector.TpText}" HorizontalAlignment="Right" FontSize="11" Foreground="#DCDCDC" FontFamily="Consolas, Courier New, monospace"/>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding StateInspector.TpPercent}"
                                                         Height="12" CornerRadius="3"
                                                         Foreground="#E5C07B" Background="#2D2D30"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Spatial Position Coordinates -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="World Position &amp; Heading" FontWeight="Bold" FontSize="12" Foreground="#A0A0A0"/>
                                        <TextBlock Text="{Binding StateInspector.CoordinatesDisplay}"
                                                   FontFamily="Consolas, Courier New, monospace" FontSize="12" Foreground="#9CDCFE"/>
                                        <TextBlock Text="{Binding StateInspector.HeadingDisplay}"
                                                   FontFamily="Consolas, Courier New, monospace" FontSize="11" Foreground="#888888"/>
                                    </StackPanel>
                                </Border>

                                <!-- Combat & Base Attributes Table -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Attributes &amp; Combat Vitals" FontWeight="Bold" FontSize="12" Foreground="#A0A0A0"/>
                                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto" Margin="0,4,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StateInspector.StatStr, StringFormat='STR: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateInspector.StatDex, StringFormat='DEX: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC" Margin="0,2"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StateInspector.StatVit, StringFormat='VIT: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StateInspector.StatAgi, StringFormat='AGI: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC" Margin="0,2"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StateInspector.StatInt, StringFormat='INT: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StateInspector.StatMnd, StringFormat='MND: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC" Margin="0,2"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding StateInspector.StatChr, StringFormat='CHR: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StateInspector.AttackDisplay, StringFormat='ATK: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E06C75" Margin="0,2"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StateInspector.DefenseDisplay, StringFormat='DEF: {0}'}" FontSize="11" FontFamily="Consolas" Foreground="#61AFEF" Margin="0,2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Engine Health & Dead-Reckoning Benchmark Card -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="Engine &amp; Simulation Health" FontWeight="Bold" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="Benchmark"
                                                    Command="{Binding StateInspector.RunDeadReckoningBenchmarkCommand}"
                                                    IsEnabled="{Binding !StateInspector.IsBenchmarking}"
                                                    Background="#3E3E42" Foreground="#9CDCFE"
                                                    FontSize="10" Padding="6,3" CornerRadius="3"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                            <TextBlock Grid.Column="0" Text="Heap Allocation Velocity:" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StateInspector.AllocationVelocityText}" FontSize="11" FontFamily="Consolas" Foreground="#E5C07B"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="GC Pause &amp; Pressure:" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StateInspector.GcPressureText}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="Spatial Partition Grid Avg:" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StateInspector.SpatialQueryText}" FontSize="11" FontFamily="Consolas" Foreground="#4EC9B0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="Dead Reckoning Latency:" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StateInspector.DeadReckoningText}" FontSize="11" FontFamily="Consolas" Foreground="#61AFEF"/>
                                        </Grid>

                                        <Separator Background="#2D2D30" Margin="0,2"/>

                                        <TextBlock Text="Benchmark Profile Output:" FontSize="10" Foreground="#808080"/>
                                        <Border Background="#252526" CornerRadius="3" Padding="6,4">
                                            <SelectableTextBlock Text="{Binding StateInspector.BenchmarkResultText}"
                                                                 FontFamily="Consolas, Courier New, monospace"
                                                                 FontSize="10"
                                                                 Foreground="#98C379"
                                                                 TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Splitter Bar -->
                    <GridSplitter Grid.Column="1" Background="#1E1E1E" ResizeDirection="Columns"/>

                    <!-- RIGHT COLUMN: Tracked World Entities Explorer -->
                    <Border Grid.Column="2" Background="#252526" CornerRadius="6" Padding="12">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Entities Toolbar -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, 120, *, Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0" Text="Type:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding StateInspector.EntityTypeOptions}"
                                          SelectedItem="{Binding StateInspector.EntityTypeFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>

                                <TextBox Grid.Column="2"
                                         Text="{Binding StateInspector.EntitySearchFilter, Mode=TwoWay}"
                                         PlaceholderText="Search Name / Actor Index (e.g. 0x015, Hare)..."
                                         Margin="10,0,10,0"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding StateInspector.TotalEntityCount, StringFormat='Entities: {0}'}"
                                           Foreground="#9CDCFE" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>

                            <!-- Table Area with Horizontal Scroll for Width Overflow -->
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Table Header with User-Resizable Columns via Thumbs -->
                                    <Grid Grid.Row="0" Margin="4,6,4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding StateInspector.ColWidthType, Mode=TwoWay}"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="{Binding StateInspector.ColWidthIndex, Mode=TwoWay}"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="{Binding StateInspector.ColWidthServerId, Mode=TwoWay}"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="{Binding StateInspector.ColWidthName, Mode=TwoWay}"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="{Binding StateInspector.ColWidthCoords, Mode=TwoWay}"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="{Binding StateInspector.ColWidthDist, Mode=TwoWay}"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="{Binding StateInspector.ColWidthHpp, Mode=TwoWay}"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 0: TYPE -->
                                        <TextBlock Grid.Column="0" Text="TYPE" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Thumb Grid.Column="1" Classes="colHeaderThumb" Tag="Type" DragDelta="OnColumnHeaderDragDelta"/>

                                        <!-- Column 2: INDEX -->
                                        <TextBlock Grid.Column="2" Text="INDEX" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Thumb Grid.Column="3" Classes="colHeaderThumb" Tag="Index" DragDelta="OnColumnHeaderDragDelta"/>

                                        <!-- Column 4: SERVER ID -->
                                        <TextBlock Grid.Column="4" Text="SERVER ID" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Thumb Grid.Column="5" Classes="colHeaderThumb" Tag="ServerId" DragDelta="OnColumnHeaderDragDelta"/>

                                        <!-- Column 6: NAME -->
                                        <TextBlock Grid.Column="6" Text="NAME" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Thumb Grid.Column="7" Classes="colHeaderThumb" Tag="Name" DragDelta="OnColumnHeaderDragDelta"/>

                                        <!-- Column 8: COORDINATES -->
                                        <TextBlock Grid.Column="8" Text="COORDINATES" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Thumb Grid.Column="9" Classes="colHeaderThumb" Tag="Coords" DragDelta="OnColumnHeaderDragDelta"/>

                                        <!-- Column 10: DIST -->
                                        <TextBlock Grid.Column="10" Text="DIST" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Thumb Grid.Column="11" Classes="colHeaderThumb" Tag="Dist" DragDelta="OnColumnHeaderDragDelta"/>

                                        <!-- Column 12: HPP -->
                                        <TextBlock Grid.Column="12" Text="HPP" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Thumb Grid.Column="13" Classes="colHeaderThumb" Tag="Hpp" DragDelta="OnColumnHeaderDragDelta"/>
                                    </Grid>

                                    <!-- Entity Rows ListBox -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding StateInspector.FilteredEntities}"
                                             Background="#1E1E1E" CornerRadius="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EntityItemViewModel">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding ((vm:MainWindowViewModel)DataContext).StateInspector.ColWidthType, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="{Binding ((vm:MainWindowViewModel)DataContext).StateInspector.ColWidthIndex, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="{Binding ((vm:MainWindowViewModel)DataContext).StateInspector.ColWidthServerId, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="{Binding ((vm:MainWindowViewModel)DataContext).StateInspector.ColWidthName, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="{Binding ((vm:MainWindowViewModel)DataContext).StateInspector.ColWidthCoords, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="{Binding ((vm:MainWindowViewModel)DataContext).StateInspector.ColWidthDist, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="{Binding ((vm:MainWindowViewModel)DataContext).StateInspector.ColWidthHpp, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Type Badge -->
                                                    <Border Grid.Column="0" Background="#2D2D30" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TypeColor}"/>
                                                    </Border>

                                                    <!-- Target Index -->
                                                    <TextBlock Grid.Column="2" Text="{Binding TargetIndexHex}"
                                                               FontSize="11" Foreground="#A0A0A0" FontFamily="Consolas, Courier New, monospace" VerticalAlignment="Center"/>

                                                    <!-- Server ID -->
                                                    <TextBlock Grid.Column="4" Text="{Binding ServerIdHex}"
                                                               FontSize="11" Foreground="#888888" HorizontalAlignment="Left" FontFamily="Consolas, Courier New, monospace" VerticalAlignment="Center"/>

                                                    <!-- Name -->
                                                    <TextBlock Grid.Column="6" Text="{Binding Name}"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                    <!-- Coordinates -->
                                                    <TextBlock Grid.Column="8" Text="{Binding PositionDisplay}"
                                                               FontSize="11" Foreground="#A0A0A0" HorizontalAlignment="Center" FontFamily="Consolas, Courier New, monospace" VerticalAlignment="Center"/>

                                                    <!-- Distance -->
                                                    <TextBlock Grid.Column="10" Text="{Binding DistanceDisplay}"
                                                               FontSize="11" Foreground="#4EC9B0" HorizontalAlignment="Right" FontFamily="Consolas, Courier New, monospace" VerticalAlignment="Center"/>

                                                    <!-- HPP -->
                                                    <TextBlock Grid.Column="12" Text="{Binding HppDisplay}"
                                                               FontSize="11" Foreground="#E5C07B" HorizontalAlignment="Right" FontFamily="Consolas, Courier New, monospace" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- TAB 4: In-Game Chat Console -->
        <TabItem Header="Chat" FontSize="14" FontWeight="SemiBold">
            <Grid RowDefinitions="Auto, *, Auto" Margin="0,10,0,0">

                <!-- TOP BAR: Session Selector, Filter, Actions -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, 160, *, Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Column="0" Text="Session:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Chat.ActiveSessions}"
                                  SelectedItem="{Binding Chat.SelectedSession, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="net:CharacterSession">
                                    <TextBlock Text="{Binding CharacterName}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Filter ComboBox -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Filter:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding Chat.FilterOptions}"
                                      SelectedItem="{Binding Chat.ChannelFilter, Mode=TwoWay}"
                                      Width="105"/>
                        </StackPanel>

                        <!-- Request LS MOTD -->
                        <Button Grid.Column="4"
                                Content="Get LS MOTD"
                                Command="{Binding Chat.RequestLsMotdCommand}"
                                Background="#3E3E42" Foreground="#98C379"
                                FontSize="11" Margin="8,0,0,0" Padding="8,4" CornerRadius="4"/>

                        <!-- Pop Out Window -->
                        <Button Grid.Column="5"
                                Content="Pop Out"
                                Command="{Binding Chat.OpenPopOutCommand}"
                                Background="#3E3E42" Foreground="#9CDCFE"
                                FontSize="11" Margin="8,0,0,0" Padding="8,4" CornerRadius="4"/>

                        <!-- Clear Button -->
                        <Button Grid.Column="6"
                                Content="Clear Log"
                                Command="{Binding Chat.ClearLogCommand}"
                                Background="#3E3E42" Foreground="#DCDCDC"
                                FontSize="11" Margin="8,0,0,0" Padding="8,4" CornerRadius="4"/>
                    </Grid>
                </Border>

                <!-- CHAT LOG DISPLAY -->
                <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="6">
                    <ListBox x:Name="MainChatListBox"
                             ItemsSource="{Binding Chat.FilteredMessages}"
                             Background="#1E1E1E" CornerRadius="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             common:AutoCopyBehavior.IsEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatItemViewModel">
                                <Grid ColumnDefinitions="Auto, Auto, Auto, *" Margin="0,2">
                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TimeDisplay}"
                                               Foreground="#808080" FontSize="11"
                                               FontFamily="Consolas, Courier New, monospace"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <!-- Channel Badge -->
                                    <Border Grid.Column="1" Background="#2D2D30" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText}"
                                                   Foreground="{Binding BadgeColor}"
                                                   FontSize="11" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Sender -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Sender, StringFormat='{}{0}: '}"
                                               Foreground="{Binding SenderColor}"
                                               FontWeight="SemiBold" FontSize="12"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>

                                    <!-- Message Body -->
                                    <SelectableTextBlock Grid.Column="3"
                                                         Text="{Binding Message}"
                                                         Foreground="{Binding MessageColor}"
                                                         FontSize="12" TextWrapping="Wrap"
                                                         VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- BOTTOM COMPOSER BAR -->
                <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                    <Grid RowDefinitions="Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto">
                            <!-- Channel Picker -->
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Chat.ChannelOptions}"
                                      SelectedItem="{Binding Chat.SelectedChannel, Mode=TwoWay}"
                                      Width="110" Margin="0,0,8,0"/>

                            <!-- Tell Recipient (Visible only for Tell) -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding Chat.TellRecipient, Mode=TwoWay}"
                                     PlaceholderText="Recipient..."
                                     Width="120" Margin="0,0,8,0"
                                     IsVisible="{Binding Chat.IsTellChannel}"/>

                            <!-- Message Input Box -->
                            <TextBox Grid.Column="2"
                                     x:Name="MainChatMessageInput"
                                     Text="{Binding Chat.OutgoingMessage, Mode=TwoWay}"
                                     PlaceholderText="Type a chat message... (Press Enter or click Send)"
                                     KeyDown="OnMainChatMessageInputKeyDown"
                                     Margin="0,0,8,0"/>

                            <!-- Send Button -->
                            <Button Grid.Column="3"
                                    Content="Send"
                                    Command="{Binding Chat.SendMessageCommand}"
                                    Background="#512BD4" Foreground="White"
                                    FontWeight="Bold" Padding="14,6" CornerRadius="4"/>
                        </Grid>

                        <!-- Status Strip -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Chat.StatusText}"
                                   Foreground="#888888" FontSize="11"
                                   Margin="2,4,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- TAB 5: Inventory & Equipment -->
        <TabItem Header="Inventory" FontSize="14" FontWeight="SemiBold">
            <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">

                <!-- TOP TOOLBAR: Session Selector, Container Quick Info, Action Buttons -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, 160, Auto, *, Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Column="0" Text="Session:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Inventory.ActiveSessions}"
                                  SelectedItem="{Binding Inventory.SelectedSession, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="net:CharacterSession">
                                    <TextBlock Text="{Binding CharacterName}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Selected Container Capacity Badge -->
                        <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="4" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Container:" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Inventory.SelectedContainer.Name}" Foreground="#9CDCFE" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="|" Foreground="#444444"/>
                                <TextBlock Text="{Binding Inventory.SelectedContainer.CapacityText, StringFormat='Capacity: {0}'}" Foreground="#4EC9B0" FontSize="11" FontFamily="Consolas, Courier New, monospace"/>
                            </StackPanel>
                        </Border>

                        <!-- Status Message Strip -->
                        <TextBlock Grid.Column="3" Text="{Binding Inventory.StatusText}" Foreground="#A0A0A0" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <!-- Sort Container Button (0x03A) -->
                        <Button Grid.Column="4"
                                Content="Sort Container"
                                Command="{Binding Inventory.SortContainerCommand}"
                                Background="#3E3E42" Foreground="#DCDCDC"
                                FontSize="11" Margin="6,0,0,0" Padding="8,4" CornerRadius="4"/>

                        <!-- Request Currencies 1 Button (0x10F) -->
                        <Button Grid.Column="5"
                                Content="Get Currencies 1"
                                Command="{Binding Inventory.RequestCurrencies1Command}"
                                Background="#3E3E42" Foreground="#E5C07B"
                                FontSize="11" Margin="6,0,0,0" Padding="8,4" CornerRadius="4"/>

                        <!-- Request Currencies 2 Button (0x115) -->
                        <Button Grid.Column="6"
                                Content="Get Currencies 2"
                                Command="{Binding Inventory.RequestCurrencies2Command}"
                                Background="#3E3E42" Foreground="#CE9178"
                                FontSize="11" Margin="6,0,0,0" Padding="8,4" CornerRadius="4"/>

                        <!-- Refresh Button -->
                        <Button Grid.Column="7"
                                Content="Refresh"
                                Command="{Binding Inventory.RefreshCommand}"
                                Background="#512BD4" Foreground="White"
                                FontSize="11" Margin="6,0,0,0" Padding="10,4" CornerRadius="4"/>
                    </Grid>
                </Border>

                <!-- MAIN THREE-COLUMN SPLIT PANE -->
                <Grid Grid.Row="1" ColumnDefinitions="230, 8, *, 8, 380">

                    <!-- COLUMN 0: Container Navigation List -->
                    <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="8">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Containers (18)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="4,2,4,6"/>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Inventory.Containers}"
                                     SelectedItem="{Binding Inventory.SelectedContainer, Mode=TwoWay}"
                                     Background="#1E1E1E" CornerRadius="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ContainerSummaryViewModel">
                                        <Grid ColumnDefinitions="*, Auto" Margin="2,3">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="#DCDCDC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="#2D2D30" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CapacityText}" FontSize="10" FontFamily="Consolas, Courier New, monospace" Foreground="#4EC9B0"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Splitter 1 -->
                    <GridSplitter Grid.Column="1" Background="#1E1E1E" ResizeDirection="Columns"/>

                    <!-- COLUMN 2: Items in Selected Container + ExtData Inspector -->
                    <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto">

                        <!-- Item Search & Filter Bar -->
                        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Text="Filter:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Inventory.ItemSearchFilter, Mode=TwoWay}"
                                         PlaceholderText="Search slot, item ID, or name (e.g. 0x015, Gil)..."/>
                            </Grid>
                        </Border>

                        <!-- Items Table -->
                        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="8">
                            <Grid RowDefinitions="Auto, *">
                                <!-- Table Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="45, *, 50, 75, 65, 80" Margin="6,2,6,6">
                                    <TextBlock Grid.Column="0" Text="SLOT" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="ITEM" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="COUNT" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="EQUIP" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="LOCK" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="BAZAAR" Foreground="#808080" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Separator Grid.Row="0" Margin="0,20,0,0" Background="#3E3E42"/>

                                <!-- Items List -->
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Inventory.FilteredItems}"
                                         SelectedItem="{Binding Inventory.SelectedItem, Mode=TwoWay}"
                                         Background="#1E1E1E" CornerRadius="4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InventoryItemViewModel">
                                            <Grid ColumnDefinitions="45, *, 50, 75, 65, 80" Margin="2,2">
                                                <!-- Slot -->
                                                <TextBlock Grid.Column="0" Text="{Binding SlotDisplay}" FontSize="11" FontFamily="Consolas, Courier New, monospace" Foreground="#888888" VerticalAlignment="Center"/>

                                                <!-- Item ID / Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding ItemDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                <!-- Count -->
                                                <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" FontSize="11" FontFamily="Consolas, Courier New, monospace" Foreground="#9CDCFE" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                <!-- Equipped Status -->
                                                <Border Grid.Column="3" Background="#2D2D30" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEquipped}">
                                                    <TextBlock Text="{Binding EquippedSlotName}" FontSize="10" FontWeight="Bold" Foreground="#E5C07B"/>
                                                </Border>

                                                <!-- Lock Flag -->
                                                <TextBlock Grid.Column="4" Text="{Binding LockDisplay}" FontSize="10" Foreground="#CE9178" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Bazaar Price -->
                                                <TextBlock Grid.Column="5" Text="{Binding PriceDisplay}" FontSize="11" FontFamily="Consolas, Courier New, monospace" Foreground="#61AFEF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Selected Item Details / Augment ExtData Card -->
                        <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                            <Grid RowDefinitions="Auto, Auto">
                                <TextBlock Grid.Row="0" Text="Selected Item Details &amp; ExtData (0x020)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                                <Grid Grid.Row="1" ColumnDefinitions="Auto, *">
                                    <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Inventory.SelectedItem.ItemDisplay, FallbackValue='(No item selected)'}" FontSize="12" FontWeight="SemiBold" Foreground="#9CDCFE"/>
                                        <TextBlock Text="{Binding Inventory.SelectedItem.SlotDisplay, StringFormat='Slot: {0}', FallbackValue='Slot: --'}" FontSize="11" Foreground="#888888"/>
                                        <TextBlock Text="{Binding Inventory.SelectedItem.CountDisplay, StringFormat='Quantity: {0}', FallbackValue='Quantity: --'}" FontSize="11" Foreground="#888888"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="24-Byte Augment / ExtData Payload:" FontSize="11" Foreground="#808080"/>
                                        <Border Background="#1E1E1E" CornerRadius="3" Padding="6,3">
                                            <SelectableTextBlock Text="{Binding Inventory.SelectedItem.ExtDataHex, FallbackValue='(None)'}"
                                                                 FontFamily="Consolas, Courier New, monospace"
                                                                 FontSize="11"
                                                                 Foreground="#4EC9B0"
                                                                 TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Splitter 2 -->
                    <GridSplitter Grid.Column="3" Background="#1E1E1E" ResizeDirection="Columns"/>

                    <!-- COLUMN 4: Equipped Gear & Currencies Pane -->
                    <Border Grid.Column="4" Background="#252526" CornerRadius="6" Padding="8">
                        <TabControl Background="Transparent">

                            <!-- SUB-TAB 1: Equipped Gear (0x050) -->
                            <TabItem Header="Equipped Gear" FontSize="12" FontWeight="SemiBold">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding Inventory.EquippedSlots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EquippedGearSlotViewModel">
                                                <Border Background="#1E1E1E" CornerRadius="4" Padding="8,5" Margin="0,2">
                                                    <Grid ColumnDefinitions="60, *, Auto">
                                                        <!-- Slot Name -->
                                                        <TextBlock Grid.Column="0" Text="{Binding SlotName}" FontWeight="Bold" FontSize="11" Foreground="#9CDCFE" VerticalAlignment="Center"/>

                                                        <!-- Item Display -->
                                                        <TextBlock Grid.Column="1" Text="{Binding ItemDisplay}" FontSize="11" Foreground="#DCDCDC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0"/>

                                                        <!-- Location Pill -->
                                                        <Border Grid.Column="2" Background="#2D2D30" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LocationDisplay}" FontSize="10" FontFamily="Consolas, Courier New, monospace" Foreground="#888888"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>

                            <!-- SUB-TAB 2: Currencies & Points (0x113 & 0x118) -->
                            <TabItem Header="Currencies &amp; Points" FontSize="12" FontWeight="SemiBold">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <StackPanel Spacing="10">

                                        <!-- Basic / Expansion Currencies -->
                                        <Border Background="#1E1E1E" CornerRadius="4" Padding="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Basic &amp; Regional Standing" FontWeight="Bold" FontSize="11" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Sparks of Eminence:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.SparksOfEminence, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E5C07B"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Unity Accolades:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.UnityAccolades, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E5C07B"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Conquest (San d'Oria):" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.ConquestSandoria, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#61AFEF"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Conquest (Bastok):" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.ConquestBastok, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#61AFEF"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Conquest (Windurst):" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.ConquestWindurst, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#61AFEF"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Imperial Standing:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.ImperialStanding, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#4EC9B0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Allied Notes:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.AlliedNotes, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#4EC9B0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Login Points:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.LoginPoints, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#9CDCFE"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Content Points & Seals -->
                                        <Border Background="#1E1E1E" CornerRadius="4" Padding="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Battle Content &amp; Seals" FontWeight="Bold" FontSize="11" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Cruor:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.Cruor, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E06C75"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Deeds of Heroism:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.Deeds, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Ancient Beastcoins:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.AncientBeastcoins, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E5C07B"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Beastman's Seals:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.BeastmansSeals, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#CE9178"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Kindred's Seals:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.KindredsSeals, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#CE9178"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Bayld:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.Bayld, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#61AFEF"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Kinetic Units:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.KineticUnits, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#4EC9B0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Coalition Imprimaturs:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.CoalitionImprimaturs, StringFormat='{}{0}'}" FontSize="11" FontFamily="Consolas" Foreground="#DCDCDC"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Endgame Currencies -->
                                        <Border Background="#1E1E1E" CornerRadius="4" Padding="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Endgame &amp; Progression" FontWeight="Bold" FontSize="11" Foreground="#A0A0A0" Margin="0,0,0,4"/>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Mweya Plasm:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.MweyaPlasm, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#C586C0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Escha Beads:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.EschaBeads, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#4EC9B0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Escha Silt:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.EschaSilt, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#4EC9B0"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Hallmarks:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.Hallmarks, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E5C07B"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Badges of Gallantry:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.BadgesOfGallantry, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E5C07B"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Domain Points:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.DomainPoints, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#9CDCFE"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Mog Segments:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.MogSegments, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#E06C75"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="Gallimaufry:" FontSize="11" Foreground="#DCDCDC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Inventory.Gallimaufry, StringFormat='{}{0:N0}'}" FontSize="11" FontFamily="Consolas" Foreground="#C586C0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- TAB 6: Interactive Command Console (CLI) -->
        <TabItem Header="Command Console" FontSize="14" FontWeight="SemiBold">
            <Grid RowDefinitions="Auto, *, Auto" Margin="0,10,0,0">

                <!-- TOP BAR: Session Selector, Target Readout, Quick Actions -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto, 160, Auto, *, Auto, Auto">
                        <TextBlock Grid.Column="0" Text="Session:" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Console.ActiveSessions}"
                                  SelectedItem="{Binding Console.SelectedSession, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="net:CharacterSession">
                                    <TextBlock Text="{Binding CharacterName}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Target Readout -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Target:" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Console.CurrentTargetName}" Foreground="#E5C07B" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Quick Action Buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0" VerticalAlignment="Center">
                            <Button Content="/pos" Command="{Binding Console.QuickPosCommand}"
                                    Background="#3E3E42" Foreground="#61AFEF" FontSize="11" Padding="6,3" CornerRadius="3"/>
                            <Button Content="/vitals" Command="{Binding Console.QuickVitalsCommand}"
                                    Background="#3E3E42" Foreground="#98C379" FontSize="11" Padding="6,3" CornerRadius="3"/>
                            <Button Content="/nearby" Command="{Binding Console.QuickNearbyCommand}"
                                    Background="#3E3E42" Foreground="#D19A66" FontSize="11" Padding="6,3" CornerRadius="3"/>
                            <Button Content="/targetinfo" Command="{Binding Console.QuickTargetInfoCommand}"
                                    Background="#3E3E42" Foreground="#C678DD" FontSize="11" Padding="6,3" CornerRadius="3"/>
                            <Button Content="/attack &lt;t&gt;" Command="{Binding Console.QuickAttackCommand}"
                                    Background="#3E3E42" Foreground="#E06C75" FontSize="11" Padding="6,3" CornerRadius="3"/>
                            <Button Content="/attackoff" Command="{Binding Console.QuickDisengageCommand}"
                                    Background="#3E3E42" Foreground="#E5C07B" FontSize="11" Padding="6,3" CornerRadius="3"/>
                        </StackPanel>

                        <!-- AutoScroll Toggle & Clear Button -->
                        <CheckBox Grid.Column="4" Content="Auto-Scroll" IsChecked="{Binding Console.AutoScroll, Mode=TwoWay}"
                                  FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="8,0,8,0"/>
                        <Button Grid.Column="5" Content="Clear" Command="{Binding Console.ClearConsoleCommand}"
                                Background="#3E3E42" Foreground="#DCDCDC" FontSize="11" Padding="8,4" CornerRadius="4"/>
                    </Grid>
                </Border>

                <!-- CONSOLE LOG OUTPUT AREA -->
                <Border Grid.Row="1" Background="#141416" CornerRadius="6" Padding="8" BorderBrush="#2D2D30" BorderThickness="1">
                    <ListBox x:Name="ConsoleListBox"
                             ItemsSource="{Binding Console.Entries}"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             common:AutoCopyBehavior.IsEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommandConsoleItemViewModel">
                                <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,1">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Text="{Binding TimeDisplay}"
                                                         Foreground="#555555"
                                                         FontFamily="Consolas, Courier New, monospace"
                                                         FontSize="11"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="1"
                                                         Text="{Binding Prefix}"
                                                         Foreground="{Binding PrefixColor}"
                                                         FontFamily="Consolas, Courier New, monospace"
                                                         FontSize="11"
                                                         FontWeight="Bold"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="2"
                                                         Text="{Binding Message}"
                                                         Foreground="{Binding MessageColor}"
                                                         FontFamily="Consolas, Courier New, monospace"
                                                         FontSize="11"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- BOTTOM INPUT STRIP -->
                <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                    <Grid RowDefinitions="Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="&gt;&gt;" Foreground="#E5C07B" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas, Courier New, monospace"/>

                            <TextBox Grid.Column="1"
                                     x:Name="ConsoleInputBox"
                                     Text="{Binding Console.InputCommand, Mode=TwoWay}"
                                     PlaceholderText="Enter command (e.g. /help, /gmhelp, /pos, /target &lt;name&gt;, /attack, /moveto x y z, !pos)..."
                                     FontFamily="Consolas, Courier New, monospace"
                                     FontSize="12"
                                     KeyDown="OnConsoleInputKeyDown"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Content="Send"
                                    Command="{Binding Console.ExecuteInputCommand}"
                                    Background="#512BD4" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12"
                                    Padding="16,6" Margin="8,0,0,0" CornerRadius="4"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Console.StatusText}"
                                   Foreground="#888888" FontSize="11"
                                   Margin="2,4,0,0"/>
                    </Grid>
                </Border>

            </Grid>
        </TabItem>

        <!-- TAB 7: Controls & Input Subsystem -->
        <TabItem Header="Controls &amp; Input" FontSize="14" FontWeight="SemiBold">
            <Grid ColumnDefinitions="380, *" Margin="0,10,0,0">

                <!-- LEFT PANE: Profiles, Presets, Settings & Real-Time Monitor -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                    <StackPanel Spacing="10">

                        <!-- PRESET & PROFILE CARD -->
                        <Border Background="#252526" CornerRadius="6" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Keyboard &amp; Mouse Presets" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>

                                <TextBlock Text="Active Configuration Profile:" Foreground="#A0A0A0" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Controls.ActivePresetName}" Foreground="#4EC9B0" FontSize="13" FontWeight="Bold"/>

                                <Separator Background="#333337" Margin="0,4"/>

                                <Button Content="Load Preset: Compact (WASD)"
                                        Command="{Binding Controls.LoadCompactPresetCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="#3E3E42" Foreground="White" FontSize="12" Margin="0,2"/>

                                <Button Content="Load Preset: Full (Numpad)"
                                        Command="{Binding Controls.LoadFullNumpadPresetCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="#3E3E42" Foreground="White" FontSize="12" Margin="0,2"/>

                                <Button Content="Load Preset: Gamepad (Standard)"
                                        Command="{Binding Controls.LoadGamepadPresetCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="#3E3E42" Foreground="#4EC9B0" FontSize="12" Margin="0,2"/>

                                <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Content="Reset Defaults"
                                            Command="{Binding Controls.ResetDefaultsCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="#2D2D30" Foreground="#A0A0A0" FontSize="11" Margin="0,0,4,0"/>

                                    <Button Grid.Column="1" Content="Save Profile"
                                            Command="{Binding Controls.SaveProfileCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="#512BD4" Foreground="White" FontSize="11" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GAMEPAD & CONTROLLER CARD -->
                        <Border Background="#252526" CornerRadius="6" Padding="15">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Gamepad &amp; Controller" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="3" Padding="6,2" BorderBrush="#3E3E42" BorderThickness="1">
                                        <TextBlock Text="{Binding Controls.GamepadStatusText}" FontSize="11" Foreground="#4EC9B0" FontFamily="Consolas, monospace"/>
                                    </Border>
                                </Grid>

                                <CheckBox IsChecked="{Binding Controls.GamepadEnabled, Mode=TwoWay}"
                                          Content="Enable Gamepad Polling"
                                          Foreground="#4EC9B0" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"/>

                                <CheckBox IsChecked="{Binding Controls.AlwaysEnableGamepad, Mode=TwoWay}"
                                          Content="Always Enable Gamepad (Accept input when unfocused)"
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,0"/>

                                <CheckBox IsChecked="{Binding Controls.IsCameraRelativeLocomotion, Mode=TwoWay}"
                                          Content="Camera-Relative 3D Movement (Type A)"
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,0"/>

                                <CheckBox IsChecked="{Binding Controls.InvertGamepadCameraX, Mode=TwoWay}"
                                          Content="Invert Gamepad Yaw (X-Axis)"
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,0"/>

                                <CheckBox IsChecked="{Binding Controls.InvertGamepadCameraY, Mode=TwoWay}"
                                          Content="Invert Gamepad Pitch (Y-Axis)"
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,0"/>

                                <CheckBox IsChecked="{Binding Controls.GamepadRumbleEnabled, Mode=TwoWay}"
                                          Content="Enable Vibration / Rumble Feedback"
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,0"/>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Stick Deadzone:" Foreground="#A0A0A0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.LeftStickDeadzone, StringFormat='{}{0:P0}'}" Foreground="#9CDCFE" FontSize="12" FontFamily="Consolas, monospace"/>
                                </Grid>
                                <Slider Minimum="0.05" Maximum="0.40" Value="{Binding Controls.LeftStickDeadzone, Mode=TwoWay}"/>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="Camera Sensitivity:" Foreground="#A0A0A0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.GamepadCameraSensitivity, StringFormat='{}{0:F1}x'}" Foreground="#9CDCFE" FontSize="12" FontFamily="Consolas, monospace"/>
                                </Grid>
                                <Slider Minimum="0.2" Maximum="3.0" Value="{Binding Controls.GamepadCameraSensitivity, Mode=TwoWay}"/>

                                <Separator Background="#333337" Margin="0,4"/>

                                <TextBlock Text="Live Controller Telemetry" FontSize="12" FontWeight="SemiBold" Foreground="#A0A0A0"/>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Thumbsticks:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.GamepadSticksText}" Foreground="#DCDCAA" FontSize="11" FontFamily="Consolas, monospace"/>
                                </Grid>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Triggers:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.GamepadTriggersText}" Foreground="#CE9178" FontSize="11" FontFamily="Consolas, monospace"/>
                                </Grid>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Buttons:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.GamepadButtonsText}" Foreground="#C586C0" FontSize="11" FontFamily="Consolas, monospace" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CAMERA & SENSITIVITY CARD -->
                        <Border Background="#252526" CornerRadius="6" Padding="15">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Camera &amp; Sensitivity" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>

                                <CheckBox IsChecked="{Binding Controls.InvertMouseX, Mode=TwoWay}"
                                          Content="Invert Mouse Look (X-Axis)"
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,4,0,0"/>

                                <CheckBox IsChecked="{Binding Controls.InvertMouseY, Mode=TwoWay}"
                                          Content="Invert Mouse Look (Y-Axis)"
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,0"/>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Mouse Sensitivity X:" Foreground="#A0A0A0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.MouseSensitivityX, StringFormat='{}{0:F1}x'}" Foreground="#9CDCFE" FontSize="12" FontFamily="Consolas, monospace"/>
                                </Grid>
                                <Slider Minimum="0.2" Maximum="3.0" Value="{Binding Controls.MouseSensitivityX, Mode=TwoWay}"/>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="Mouse Sensitivity Y:" Foreground="#A0A0A0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.MouseSensitivityY, StringFormat='{}{0:F1}x'}" Foreground="#9CDCFE" FontSize="12" FontFamily="Consolas, monospace"/>
                                </Grid>
                                <Slider Minimum="0.2" Maximum="3.0" Value="{Binding Controls.MouseSensitivityY, Mode=TwoWay}"/>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="Keyboard Turn Speed:" Foreground="#A0A0A0" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.TurnSpeed, StringFormat='{}{0:F0}°/s'}" Foreground="#9CDCFE" FontSize="12" FontFamily="Consolas, monospace"/>
                                </Grid>
                                <Slider Minimum="60" Maximum="360" Value="{Binding Controls.TurnSpeed, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- REAL-TIME TELEMETRY & INPUT MONITOR -->
                        <Border Background="#252526" CornerRadius="6" Padding="15">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Live Input &amp; Locomotion Monitor" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>

                                <Grid ColumnDefinitions="110, *" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Locomotion:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.CurrentSpeedText}" Foreground="#4EC9B0" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Facing Heading:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.CurrentHeadingText}" Foreground="#DCDCAA" FontSize="12"/>
                                </Grid>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="3D Camera:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.CameraInfoText}" Foreground="#9CDCFE" FontSize="12" FontFamily="Consolas, monospace"/>
                                </Grid>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Autorun:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.AutorunStatusText}" Foreground="#CE9178" FontSize="12"/>
                                </Grid>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Movement Mode:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.WalkingStatusText}" Foreground="#E5C07B" FontSize="12"/>
                                </Grid>

                                <Separator Background="#333337" Margin="0,4"/>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Held Keys:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.HeldKeysText}" Foreground="#C586C0" FontSize="12" FontFamily="Consolas, monospace" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid ColumnDefinitions="110, *">
                                    <TextBlock Grid.Column="0" Text="Active Actions:" Foreground="#888888" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Controls.ActiveActionsText}" Foreground="#61AFEF" FontSize="12" FontFamily="Consolas, monospace" TextWrapping="Wrap"/>
                                </Grid>

                                <Border Background="#1A1A1C" CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Controls.StatusMessage}" Foreground="#E5C07B" FontSize="11" FontFamily="Consolas, monospace" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT PANE: Action Keybindings Table -->
                <Border Grid.Column="1" Background="#252526" CornerRadius="6" Padding="15">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Keybindings &amp; Logical Actions" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Active action bindings mapped for character locomotion, camera, targeting, and hotbars." Foreground="#888888" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" BorderBrush="#333337" BorderThickness="1">
                            <Grid RowDefinitions="Auto, *">
                                <!-- Header Row -->
                                <Border Grid.Row="0" Background="#2D2D30" Padding="10,6" BorderBrush="#333337" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="120, 220, *">
                                        <TextBlock Grid.Column="0" Text="CATEGORY" FontWeight="Bold" FontSize="11" Foreground="#A0A0A0"/>
                                        <TextBlock Grid.Column="1" Text="ACTION" FontWeight="Bold" FontSize="11" Foreground="#A0A0A0"/>
                                        <TextBlock Grid.Column="2" Text="ASSIGNED CHORDS" FontWeight="Bold" FontSize="11" Foreground="#A0A0A0"/>
                                    </Grid>
                                </Border>

                                <!-- Bindings Rows -->
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Controls.Bindings}"
                                         Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InputBindingItemViewModel">
                                            <Grid ColumnDefinitions="120, 220, *" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Category}" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ActionName}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" Background="#252526" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding BoundChords}" Foreground="#4EC9B0" FontSize="12" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
